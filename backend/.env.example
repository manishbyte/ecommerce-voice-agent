# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5000/voice_agent
# Optional. Defaults to DATABASE_URL with the asyncpg driver swapped for plain postgresql://
CHECKPOINT_DATABASE_URL=

# --- Groq (LLM) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Separate model for the LLM-as-a-Judge (reduces evaluator bias). Falls back to GROQ_MODEL.
GROQ_JUDGE_MODEL=

# --- Gnani (STT + TTS) ---
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v2.5
STT_SAMPLE_RATE=16000
TTS_SAMPLE_RATE=24000

# --- Business rules ---
RETURN_WINDOW_DAYS=10
PENDING_ACTION_TTL_SECONDS=300
MAX_INPUT_CHARS=1000

# --- Misc ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501
STORE_AUDIO=false
